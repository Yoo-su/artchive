{
  "name": "bookjeok-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@bookjeok/web --filter=@bookjeok/server",
    "dev:native": "turbo dev --filter=@bookjeok/native --filter=@bookjeok/server",
    "dev:server": "turbo dev --filter=@bookjeok/server",
    "dev:all": "turbo dev",
    "build": "turbo build",
    "clean": "rm -rf .turbo apps/web/.next apps/web/.turbo apps/native/.turbo apps/server/dist packages/*/dist packages/*/.turbo",
    "build:clean": "pnpm clean && pnpm build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test"
  },
  "devDependencies": {
    "turbo": "2.7.4",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": "22.x"
  }
}
