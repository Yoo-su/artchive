{
  "name": "bookjeok-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@bookjeok/web --filter=@bookjeok/server",
    "dev:native": "turbo dev --filter=@bookjeok/native --filter=@bookjeok/server",
    "dev:server": "turbo dev --filter=@bookjeok/server",
    "dev:all": "turbo dev",
    "build": "turbo build",
    "clean": "rm -rf .turbo apps/web/.next apps/web/.turbo apps/native/.turbo apps/server/dist packages/*/dist packages/*/.turbo",
    "build:clean": "pnpm clean && pnpm build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test"
  },
  "devDependencies": {
    "turbo": "2.7.4",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": "22.x"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.1",
      "@types/react-dom": "18.3.1"
    }
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
