{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NAVER_CLIENT_ID",
    "NAVER_CLIENT_SECRET",
    "CULTURE_SERVICE_KEY",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_KAKAO_APP_KEY",
    "NEXT_PUBLIC_GOOGLE_ADSENSE_ID",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
