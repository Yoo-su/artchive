{
  "name": "@bookjeok/react-query",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bookjeok/core": "workspace:*",
    "@bookjeok/api-client": "workspace:*",
    "@lukemorales/query-key-factory": "^1.3.4"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "tsup": "^8.0.0",
    "vitest": "^1.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "axios": "^1.11.0",
    "@tanstack/react-query": "^5.84.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "axios": "^1.11.0",
    "@tanstack/react-query": "^5.0.0"
  }
}
