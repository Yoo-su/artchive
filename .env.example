# ==============================================================================
# 로컬 개발 환경용 환경변수 템플릿 (.env.example)
# 이 파일을 복사하여 루트에 .env 파일을 만들고 실제 값을 채워 넣어주세요.
# .env 파일은 Git 형상관리 대상에서 자동으로 제외되므로 보안상 안전합니다.
# ==============================================================================

# Node 환경
NODE_ENV=development
PORT=8000

# 데이터베이스 (PostgreSQL)
# 로컬(호스트)에서 pnpm dev 구동 시: localhost:5432 / Docker 내에서만 구동 시: db:5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookjeok
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=bookjeok
DATABASE_SSL=false

# JWT 인증 토큰 시크릿 키
# (충분히 길고 안전한 임의의 문자열을 적어주세요.)
JWT_SECRET=your_jwt_access_secret_key_here_minimum_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_minimum_32_characters

# 도메인 설정 (소셜 로그인 및 콜백 처리에 필요)
CLIENT_DOMAIN=http://localhost:3000

# 네이버 소셜 로그인 및 검색 API 연동 키
# (네이버 개발자 센터에서 앱을 만들고 발급받은 실제 값을 기재하세요.)
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NAVER_CALLBACK_URL=http://localhost:8000/api/auth/naver/callback

# 카카오 소셜 로그인 연동 키
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_CALLBACK_URL=http://localhost:8000/auth/kakao/callback

# 문화예술정보 공공 API 키
CULTURE_SERVICE_KEY=your_culture_service_public_api_key

# Google Generative AI (Gemini) API 키
# (Google AI Studio에서 발급받은 API 키를 기재하세요.)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Vercel Blob 스토리지 인증 키 (도서 이미지 업로드/삭제 필수)
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token_here

# 프론트엔드 빌드 타임 주입 환경변수
# (Next.js 빌드 시 클라이언트 측에서 바라볼 백엔드 주소입니다.)
NEXT_PUBLIC_API_URL=http://localhost:8000
